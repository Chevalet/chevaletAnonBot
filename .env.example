# ChevaletAnonBot configuration. Copy to `.env` and fill in.
# `.env` is git-ignored — never commit real tokens.

# --- Telegram ---
BOT_TOKEN=...

# Outbound proxy for reaching Telegram (and the AI endpoint), if your host can't
# reach api.telegram.org directly. Leave empty to connect directly.
# Examples: socks5://127.0.0.1:1080  |  http://user:pass@host:port
PROXY=

REPORT_CHAT_ID=-100...
ERROR_CHAT_ID=-100...

ADMINS=111111 # divide by "|"
SELLER_ADMIN=username
SUPPORT_ADMIN=username

# --- Database (PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mydatabase
DB_USER=root
DB_PASS=pass
# libpq sslmode. Optional; defaults to "prefer" — TLS when the server offers it,
# plain TCP otherwise, which is what the Docker stack's PostgreSQL does. Use
# "require" for a managed database that mandates TLS, "disable" only on a
# trusted private network.
DB_SSLMODE=prefer

# --- Logging ---
LOG_LEVEL=INFO

# --- Limits ---
MAX_NAME_LENGTH=100

DEFAULT_CID_LIMIT=2
MAX_CID_LENGTH=30
MIN_CID_LENGTH=5

# --- Health check (TCP listener) ---
HEALTH_PORT=12564
BOT_HEALTH_PORT=12564
BASE_ADDRESS=/health

# --- Good-morning / good-night greetings (Asia/Tehran) ---
SEND_GM_GN=true
GM_TIME=07:00
GN_TIME=23:00
GM_GROUP_ID=-100...
GM_GROUP_TOPIC_ID=2

# --- AI auto-reply (optional, OFF by default) ---
# The GM-group AI auto-reply POSTs to AI_URL server-side; leave AI_ENABLED unset/
# false to disable the feature entirely (no outbound POST, no SSRF surface).
# Only enable it once AI_URL points at a trusted, allow-listed endpoint.
AI_ENABLED=false
AI_URL=http://...
AI_SESSION_ID=123456789
AI_INTERVAL=5

# --- Nightly DB backup (optional, OFF by default) ---
# When BACKUP_CHAT_ID is set, the bot sends the newest DB backup file to THAT
# chat (and only that chat — it never broadcasts) once a day at BACKUP_TIME
# (Asia/Tehran, default 02:17). Can be a personal DM (an ADMINS id) or a
# private channel/supergroup id (negative, typically -100xxxxxxxxxx) — for a
# channel, the bot must already be added there as an admin (with post
# permission) or the send just fails. Leave BACKUP_CHAT_ID empty to disable.
BACKUP_CHAT_ID=
BACKUP_TIME=02:17

# --- Misc ---
# Default donation URL. An admin can override it at runtime with
# /admin_donate link <url>, and the donation button itself is off until
# /admin_donate active.
DONATION_LINK="https://daramet.com/Chevalet"

# Where runtime-tunable settings (donation button, AI url/session) are persisted.
# Optional; defaults to ./dynamic_settings.json. In Docker this MUST point at a
# mounted path, otherwise every redeploy recreates the container and resets
# whatever an admin configured (see deploy/go/docker-compose.cutover.yml).
# DYNSET_PATH=/app/state/dynamic_settings.json
